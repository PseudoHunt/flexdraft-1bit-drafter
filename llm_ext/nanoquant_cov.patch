+# -----------------------------------------------------------------------------
+# Hook Functions: input covariance (full "Hessian") accumulation
+# -----------------------------------------------------------------------------
+# Linears that read the same activation share one covariance (q/k/v read the input layernorm,
+# gate/up read the post-attention layernorm), so it is collected once per group.
+COV_ALIAS = {
+    "self_attn.k_proj": "self_attn.q_proj",
+    "self_attn.v_proj": "self_attn.q_proj",
+    "mlp.up_proj": "mlp.gate_proj",
+}
+
+
+def cov_source_name(name: str) -> str:
+    """Name of the layer whose covariance `name` shares (itself, unless aliased)."""
+    suffix = ".".join(name.split(".")[-2:])
+    target = COV_ALIAS.get(suffix)
+    if target is None:
+        return name
+    return name[:len(name) - len(suffix)] + target
+
+
+def _cov_hook(module, inputs, outputs, layer_name, cov_dict, cov_states, stats_device, clip=True):
+    """Accumulates E[x x^T] with exactly the clipping the i_norm hook applies, so that
+    diag(Sigma) == i_norm (bit-for-bit up to float association)."""
+    x = inputs[0].detach().flatten(0, -2).float()
+
+    if clip:
+        norms = torch.norm(x, dim=1, keepdim=True)
+        tau = _get_robust_batch_tau(norms, PERCENTILE)
+        state = cov_states[layer_name]
+        gmax = state["global_max"]
+        if gmax is None:
+            gmax = tau
+        elif tau > gmax:
+            correction = (tau / (gmax + 1e-8)).square()
+            cov_dict[layer_name].mul_(correction.to(cov_dict[layer_name].device))
+            gmax = tau
+        state["global_max"] = gmax
+        x = x * torch.clamp(gmax / (norms + 1e-8), max=1.0)
+
+    update = (x.mT @ x) / x.shape[0]
+    cov_dict[layer_name].add_(update.to(cov_dict[layer_name].device))
+
+
