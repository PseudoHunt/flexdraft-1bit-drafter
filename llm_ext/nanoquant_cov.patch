+
+
+@torch.no_grad()
+def _get_cov_side(cov, shrinkage, device, eig_device="cuda", corr_shrink=0.0):
+    key = (cov.data_ptr(), cov.shape[0], round(float(shrinkage), 6), round(float(corr_shrink), 6))
+    side = _COV_CACHE.get(key)
+    if side is None:
+        Sigma = shrink_cov(cov.to(eig_device), shrinkage)
+        side = CovSide(Sigma, corr_shrink=corr_shrink)
+        del Sigma
+        if len(_COV_CACHE) >= _COV_CACHE_MAX:
+            _COV_CACHE.pop(next(iter(_COV_CACHE)))
+        _COV_CACHE[key] = side
+    if side.Q.device != torch.device(device):
+        side.Q = side.Q.to(device)
+        side.lam = side.lam.to(device)
+        side.Lr = side.Lr.to(device)
+        side.i_norm = side.i_norm.to(device)
+    return side
+
+
+@torch.no_grad()
+def _output_error(W, W_hat, cov):
+    """tr(E Sigma E^T) / tr(W Sigma W^T): the layer-output error the covariance objective targets."""
+    if cov is None:
+        return None
+    E = (W - W_hat).float()
+    Wf = W.float()
+    Sigma = cov.to(W.device, torch.float32)
+    num = ((E @ Sigma) * E).sum().item()
+    den = ((Wf @ Sigma) * Wf).sum().item()
+    return num / den if den > 0 else None
+
